{
  "name": "bakery-ledger",
  "version": "1.5.6",
  "description": "Recipes, costing and profit tracking for small bakeries",
  "main": "desktop.cjs",
  "author": "Bakery Ledger",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"test/**/*.js\" \"*.{cjs,js,json,html}\" \".github/workflows/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"test/**/*.js\" \"*.{cjs,js,json,html}\" \".github/workflows/*.{yml,yaml}\"",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "release": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.4.2",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.bakeryledger.app",
    "productName": "Bakery Ledger",
    "artifactName": "Bakery-Ledger-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop.cjs",
      "preload.cjs",
      "release-notes.cjs",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Bakery Ledger"
    },
    "publish": {
      "provider": "github",
      "owner": "webswe",
      "repo": "Bakery-app"
    }
  },
  "type": "module"
}
